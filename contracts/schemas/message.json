{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "message.json",
  "title": "Message",
  "description": "The shared message shape used by the Gateway API, Gateway-Agent Loop contract, and Model API (D178). Content is a list of parts (D179); tool calls and results are ordinary parts and are preserved in conversation history.",
  "type": "object",
  "required": ["role", "content"],
  "allOf": [
    {
      "if": { "properties": { "role": { "const": "tool" } } },
      "then": {
        "properties": {
          "content": {
            "items": { "$ref": "#/$defs/ToolResultPart" }
          }
        }
      }
    },
    {
      "if": { "properties": { "role": { "enum": ["system", "user"] } } },
      "then": {
        "properties": {
          "content": {
            "items": {
              "not": {
                "oneOf": [
                  { "$ref": "#/$defs/ToolCallPart" },
                  { "$ref": "#/$defs/ToolResultPart" }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "role": { "const": "assistant" } } },
      "then": {
        "properties": {
          "content": {
            "items": { "not": { "$ref": "#/$defs/ToolResultPart" } }
          }
        }
      }
    }
  ],
  "properties": {
    "role": {
      "type": "string",
      "enum": ["system", "user", "assistant", "tool"],
      "description": "The sender role. Tool results use the tool role; tool calls are parts of an assistant message."
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ContentPart" },
      "description": "Ordered content parts. Text is the first supported part; images, files, tool calls, and tool results are represented without changing the message shape."
    }
  },
  "$defs": {
    "ContentPart": {
      "oneOf": [
        { "$ref": "#/$defs/TextPart" },
        { "$ref": "#/$defs/ImagePart" },
        { "$ref": "#/$defs/FilePart" },
        { "$ref": "#/$defs/ToolCallPart" },
        { "$ref": "#/$defs/ToolResultPart" }
      ]
    },
    "TextPart": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ImagePart": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "image" },
        "url": { "type": "string", "format": "uri" },
        "mime_type": { "type": "string" }
      },
      "additionalProperties": false
    },
    "FilePart": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "file" },
        "url": { "type": "string", "format": "uri" },
        "name": { "type": "string" },
        "mime_type": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ToolCallPart": {
      "type": "object",
      "required": ["type", "id", "source_id", "name", "arguments"],
      "properties": {
        "type": { "const": "tool_call" },
        "id": { "type": "string" },
        "source_id": { "type": "string", "minLength": 1, "description": "Stable source identity from the tool definition; source_id plus name identifies the tool." },
        "name": { "type": "string" },
        "arguments": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "ToolResultPart": {
      "type": "object",
      "required": ["type", "tool_call_id", "result"],
      "properties": {
        "type": { "const": "tool_result" },
        "tool_call_id": { "type": "string" },
        "result": {},
        "is_error": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "role": "system",
      "content": [{ "type": "text", "text": "Read /AGENT.md for your instructions." }]
    },
    {
      "role": "user",
      "content": [{ "type": "text", "text": "Help me plan my finances" }]
    },
    {
      "role": "assistant",
      "content": [
        { "type": "text", "text": "I'll read your finance page..." },
        {
          "type": "tool_call",
          "id": "tc_1",
          "source_id": "mcp:filesystem",
          "name": "read_file",
          "arguments": { "path": "/finances/AGENT.md" }
        }
      ]
    },
    {
      "role": "tool",
      "content": [
        {
          "type": "tool_result",
          "tool_call_id": "tc_1",
          "result": "# Finances\nBudget goal: ..."
        }
      ]
    }
  ]
}
